{
  "name": "svg",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "svg : un editeur SVG autonome, un convertisseur d'image en SVG et une bibliotheque de 4 000 formes.",
  "keywords": ["svg", "editor", "vector", "vectorization", "icons", "react"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bertrandra/svg.git"
  },
  "bugs": {
    "url": "https://github.com/bertrandra/svg/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint src tests",
    "cliquet": "node scripts/cliquet.mjs",
    "verifier": "npm run typecheck && npm run lint && npm run cliquet && npm test",
    "construire": "node scripts/construire.mjs && node scripts/vtracer.mjs && node scripts/bibliotheque.mjs && node scripts/polices.mjs && node scripts/embarquer.mjs && node scripts/mentions.mjs --dist && node scripts/site-php.mjs",
    "site-php": "node scripts/site-php.mjs",
    "test:php": "php tests/php/lancer.php",
    "bibliotheque": "node scripts/bibliotheque.mjs",
    "polices": "node scripts/polices.mjs",
    "vtracer": "node scripts/vtracer.mjs",
    "embarquer": "node scripts/embarquer.mjs",
    "mentions": "node scripts/mentions.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@expo-google-fonts/bebas-neue": "0.4.1",
    "@expo-google-fonts/caveat": "0.4.2",
    "@expo-google-fonts/fredoka": "0.4.1",
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/lobster": "0.4.1",
    "@expo-google-fonts/oswald": "0.4.2",
    "@expo-google-fonts/pacifico": "0.4.1",
    "@expo-google-fonts/playfair-display": "0.4.2",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@iconify-json/game-icons": "1.2.4",
    "@iconify-json/healthicons": "1.2.13",
    "@iconify-json/lucide": "1.2.142",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/ph": "1.2.2",
    "@iconify-json/tabler": "1.2.42",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "axe-core": "4.14.0",
    "esbuild": "0.24.2",
    "eslint": "^9.17.0",
    "hersheytext": "2.0.0",
    "playwright": "1.56.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@visioncortex/vtracer": "1.0.0-alpha.4",
    "opentype.js": "2.0.0",
    "polygon-clipping": "0.15.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
