# La securite de base du site (ADR-0030, docs/deploiement-php.md), pour Apache. PHP pose lui-meme ses en-tetes (politique de
# securite du contenu comprise) ; ce fichier couvre ce que PHP ne sert pas : les fichiers de assets/.

# Pas de listage d'un dossier, et la page d'accueil est index.php.
Options -Indexes
DirectoryIndex index.php

# Les reglages et le code ne se servent jamais directement.
<FilesMatch "^(config|config\.local)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

AddType text/javascript .js
AddType text/css .css

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
